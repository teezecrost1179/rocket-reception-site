# Enable rewrite engine
RewriteEngine On
RewriteBase /
Options -MultiViews

# ---------------------------------------
# 1. Remove .php from URLs
# ---------------------------------------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+)$ $1.php [L]

# ---------------------------------------
# 2. Allow both .php and clean URLs
# (no redirect; both will resolve)
# ---------------------------------------

# ---------------------------------------
# 3. Optional: Default index handling
# ---------------------------------------
DirectoryIndex index.php

# ---------------------------------------
# 4. Prevent direct access to includes (optional but smart)
# ---------------------------------------
<FilesMatch "(header|footer|config|includes)\.php$">
    Require all denied
</FilesMatch>
